{
  "version": "1.0",
  "description": "Initial ontology for UX Research Intelligence. Labels are structured as namespace:value.",
  "namespaces": {
    "domain": [
      "usability",
      "learnability",
      "accessibility",
      "navigation",
      "discoverability",
      "information_architecture",
      "content_clarity",
      "performance",
      "error_handling",
      "trust",
      "feedback",
      "visual_design",
      "workflow",
      "onboarding"
    ],
    "issue": [
      "navigation",
      "discoverability",
      "learnability",
      "accessibility",
      "performance",
      "error_recovery",
      "content_clarity",
      "information_architecture",
      "feedback",
      "trust",
      "workflow",
      "onboarding"
    ],
    "response": [
      "positive",
      "neutral",
      "negative",
      "confusion",
      "frustration",
      "satisfaction",
      "confidence",
      "uncertainty"
    ],
    "outcome": [
      "task_success",
      "task_friction",
      "task_failure",
      "abandonment",
      "workaround",
      "delay",
      "repeat_attempt",
      "no_issue"
    ]
  },
  "relationships": [
    ["user", "has_goal", "goal"],
    ["user", "performs", "task"],
    ["user", "encounters", "issue"],
    ["user", "experiences", "response"],
    ["issue", "affects", "outcome"],
    ["issue", "motivates", "recommendation"]
  ]
}
